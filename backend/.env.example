# Server Configuration
PORT=3000
JWT_SECRET=your_secure_jwt_secret_here_change_this_in_production

# Redpanda Kafka (Kafka-compatible broker)
KAFKA_BROKER=your-broker.redpanda.com:9092
KAFKA_USERNAME=your_kafka_username
KAFKA_PASSWORD=your_kafka_password
KAFKA_TOPIC=monkihub_messages

# Server URL (for consumer to connect back via Socket.IO)
# Local development:
SERVER_URL=http://localhost:3000
# Production (uncomment and update when deployed):
# SERVER_URL=https://your-app.onrender.com

# Node Environment
NODE_ENV=development
